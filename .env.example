# Copy this file to .env and fill in your values.

# Enables AI invoice scanning. Without it the app still works for manual entry.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: model used to read invoices. Defaults to claude-opus-4-7.
# Set to claude-haiku-4-5 for cheaper, higher-volume scanning.
# EXTRACTION_MODEL=claude-opus-4-7

# Optional: override the SQLite location.
# DATABASE_URL=sqlite:///data.db
